# PUBLIC TEMPLATE ONLY. Do not use this as-is, and never commit real .env.
# See the official Immich release's example.env for the version in use.
# Example external NTFS disk path: replace X: on the actual Windows host.
UPLOAD_LOCATION=X:/Immich/Library
# Docker-managed Linux volume, NOT a Windows NTFS bind mount.
DB_DATA_LOCATION=pgdata
TZ=Etc/UTC
IMMICH_VERSION=v3
# Replace with a unique random alphanumeric secret in a private .env.
DB_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# In the official downloaded docker-compose.yml, ensure the top-level
# volumes block also declares pgdata:, alongside model-cache:.
